<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Additional, opt-in runner. The ordinary AndroidJUnitRunner remains registered. -->
    <instrumentation
        android:name="com.fluxa.app.ReaderAccessibilityRunner"
        android:targetPackage="com.fluxa.app.debug" />
    <application>
        <!-- Test APK only; never merged into the downloadable application APK. -->
        <service
            android:name="com.fluxa.app.ReaderAccessibilityService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice"
                android:resource="@xml/reader_test_accessibility" />
        </service>
    </application>
</manifest>
